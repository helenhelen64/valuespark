# 配置任意一个或多个供应商。真实密钥只保存在服务端。

# 可选：auto 会使用第一个已配置供应商，也可填写 openai、anthropic、
# gemini、deepseek、kimi、openrouter、ollama。
AI_PROVIDER=auto

OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-5.6-sol

ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-sonnet-5

GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.6-flash

DEEPSEEK_API_KEY=your-deepseek-key
DEEPSEEK_MODEL=deepseek-v4-pro

MOONSHOT_API_KEY=your-kimi-key
MOONSHOT_MODEL=kimi-k2.6

OPENROUTER_API_KEY=sk-or-your-key
OPENROUTER_MODEL=openrouter/auto
APP_URL=http://localhost:4173

# 账户与个人 API Key。先在 Supabase SQL Editor 执行
# supabase/migrations/202607280001_account_api_keys.sql。
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 至少 32 个字符。生产环境请使用密码生成器创建独立随机值。
ACCOUNT_KEY_ENCRYPTION_SECRET=replace-with-a-random-secret-at-least-32-characters

# 邮箱登录默认开启；手机号需要先在 Supabase 配置短信服务商。
AUTH_EMAIL_ENABLED=true
AUTH_PHONE_ENABLED=false

# 只列出已在 Supabase 配置完成的登录渠道。
# 原生示例：google,apple,twitter,facebook,github
# 自定义 OAuth/OIDC 示例：wechat:custom_wechat:微信,qq:custom_qq:QQ
AUTH_SOCIAL_PROVIDERS=google,apple,twitter

# Ollama 本地运行示例。先执行：ollama pull qwen3
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3
